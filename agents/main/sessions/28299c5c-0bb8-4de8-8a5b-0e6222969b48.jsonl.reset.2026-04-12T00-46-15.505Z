{"type":"message","id":"e60ae959","parentId":"3a4b528b","timestamp":"2026-04-11T09:40:42.984Z","message":{"role":"toolResult","toolCallId":"call_function_v59bfg4dii87_1","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env bash\n#============================================================\n# 记忆同步检查脚本 - sync-memory.sh\n# 德胧 AI 共享池 · 所有 AI 伙伴启动时运行\n#\n# 用法:\n#   bash sync-memory.sh           # 检查缺失知识块并提示读取\n#   bash sync-memory.sh refresh   # 强制刷新热力榜并重新检查\n#   bash sync-memory.sh diff       # 仅显示与本地 MEMORY.md 的差异\n#============================================================\n\nset -euo pipefail\n\nSHARED_POOL=\"/root/.openclaw/workspace/shared-pool\"\nSCENE_BLOCKS=\"/root/.openclaw/memory-tdai/scene_blocks\"\nHEATLIST=\"$SHARED_POOL/记忆热力榜.md\"\nMEMORY=\"${MEMORY_FILE:-/root/.openclaw/workspace/MEMORY.md}\"\nHOSTNAME=\"${HOSTNAME:-$(hostname)}\"\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\n\n# 颜色输出\nRED='\\033[0;31m'; YELLOW='\\033[1;33m'; GREEN='\\033[0;32m'\nCYAN='\\033[0;36m'; BOLD='\\033[1m'; RESET='\\033[0m'\n\nlog() { echo -e \"${GREEN}[sync]${RESET} $*\"; }\nwarn() { echo -e \"${YELLOW}[warn]${RESET} $*\" >&2; }\ninfo() { echo -e \"${CYAN}[info]${RESET} $*\"; }\nerr()  { echo -e \"${RED}[err]${RESET} $*\" >&2; }\n\n#------------------------------------------------------------\n# 辅助函数：从热力榜提取 TOP10 知识块标题列表\n#------------------------------------------------------------\nextract_top_blocks() {\n    local heatlist=\"$1\"\n    grep -E '^\\| [🥇🥈🥉] |^\\| [0-9]+ ' \"$heatlist\" \\\n        | awk -F'\\|' '{\n            title = $3\n            gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", title)\n            gsub(/\\*\\*/, \"\", title)\n            print title\n        }' \\\n        | head -10\n}\n\n#------------------------------------------------------------\n# 函数：从热力榜解析\"适用场景标签\"列\n#------------------------------------------------------------\nextract_tags() {\n    local heatlist=\"$1\"\n    awk '\n        BEGIN { in_table=0 }\n        /^\\| 排名 / { in_table=1; next }\n        /^\\| ---/ { next }\n        in_table && /^\\|/ {\n            # count pipes to find the tags column (last non-empty column before ---)\n            n = split($0, cols, /\\|/)\n            # tags are in the last column\n            tag = cols[n]\n            gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", tag)\n            if (tag != \"\" && tag != \"适用场景标签\" && tag ~ /`/) {\n                gsub(/`/, \"\", tag)\n                print tag\n            }\n        }\n    ' \"$heatlist\"\n}\n\n#------------------------------------------------------------\n# 函数：从 scene_blocks 目录获取所有有效知识块文件名列表\n#------------------------------------------------------------\nlist_active_blocks() {\n    local dir=\"$1\"\n    find \"$dir\" -maxdepth 1 -name \"*.md\" -type f | while read -r f; do\n        # 检查是否标记 deleted\n        if grep -q \"deleted: true\" \"$f\" 2>/dev/null; then\n            continue\n        fi\n        # 检查 heat:0 且无显式引用\n        if grep -q \"heat: 0\" \"$f\" 2>/dev/null; then\n            continue\n        fi\n        basename \"$f\" .md\n    done\n}\n\n#------------------------------------------------------------\n# 函数：获取本地 MEMORY.md 已记录的知识块标题\n#------------------------------------------------------------\nget_local_known_blocks() {\n    local memory=\"$1\"\n    if [[ -f \"$memory\" ]]; then\n        grep -E \"^## 热度知识块|^### 知识块|^-\\s+\\[.*\\]\" \"$memory\" 2>/dev/null \\\n            | sed 's/^##* //' | sed 's/^\\-\\s\\+//' | sed 's/\\[\\(.*\\)\\].*/\\1/'\n    fi\n}\n\n#------------------------------------------------------------\n# 函数：生成推荐读取列表（热力榜 TOP10 中本地缺失的）\n#------------------------------------------------------------\nfind_missing_blocks() {\n    local heatlist=\"$1\"\n    local memory=\"$2\"\n    local missing=()\n\n    # 从热力榜提取 TOP10 标题（精确匹配文件名去掉.md）\n    while IFS= read -r title; do\n        [[ -z \"$title\" ]] && continue\n        # 检查本地 memory 是否已记录此知识块\n        if ! grep -q \"$title\" \"$memory\" 2>/dev/null; then\n            missing+=(\"$title\")\n        fi\n    done < <(extract_top_blocks \"$heatlist\")\n\n    printf '%s\\n' \"${missing[@]}\"\n}\n\n#------------------------------------------------------------\n# 函数：从热力榜获取知识块摘要（通过标题查找 META-START 后的 summary）\n#------------------------------------------------------------\nget_block_summary() {\n    local block_name=\"$1\"\n    local blocks_dir=\"$2\"\n    local file=\"$blocks_dir/${block_name}.md\"\n    if [[ -f \"$file\" ]]; then\n        awk '/^-----META-START-----/{found=1; next} /^-----META-END-----/{found=0} found && /^summary:/{\n            sub(/^summary:\\s*/, \"\"); print; exit\n        }' \"$file\" 2>/dev/null || echo \"(无摘要，请直接读取源文件)\"\n    else\n        echo \"(源文件不存在)\"\n    fi\n}\n\n#------------------------------------------------------------\n# 命令：refresh — 强制刷新热力榜（重新计算得分）\n#------------------------------------------------------------\ncmd_refresh() {\n    log \"${BOLD}强制刷新热力榜${RESET}\"\n    info \"本脚本不自动重写热力榜（由主 agent 每日复盘时更新）\"\n    info \"热力榜路径：$HEATLIST\"\n    info \"如需手动编辑热力榜，请直接修改该文件或触发主 agent 复盘任务\"\n}\n\n#------------------------------------------------------------\n# 命令：diff — 显示本地 MEMORY.md 与热力榜差异\n#------------------------------------------------------------\ncmd_diff() {\n    echo \"\"\n    info \"========== 热力榜 TOP10 vs 本地 MEMORY.md 差异 ==========\"\n    echo \"\"\n\n    local missing\n    mapfile -t missing < <(find_missing_blocks \"$HEATLIST\" \"$MEMORY\")\n\n    if [[ ${#missing[@]} -eq 0 ]]; then\n        log \"本地 MEMORY.md 已覆盖所有热力榜 TOP10 知识块 ✅\"\n    else\n        warn \"发现 ${#missing[@]} 个热力榜知识块本地缺失：\"\n        echo \"\"\n        for title in \"${missing[@]}\"; do\n            local summary\n            summary=$(get_block_summary \"$title\" \"$SCENE_BLOCKS\")\n            echo -e \"  ${YELLOW}• ${title}${RESET}\"\n            echo -e \"    摘要：${summary}\"\n            echo \"\"\n        done\n    fi\n}\n\n#------------------------------------------------------------\n# 命令：默认 — 完整同步检查\n#------------------------------------------------------------\ncmd_check() {\n    echo \"\"\n    echo -e \"${BOLD}═══════════════════════════════════════════════════════${RESET}\"\n    echo -e \"${BOLD}  🧠 德胧 AI 记忆同步检查  ·  $TIMESTAMP${RESET}\"\n    echo -e \"${BOLD}  主机：$HOSTNAME${RESET}\"\n    echo -e \"${BOLD}═══════════════════════════════════════════════════════${RESET}\"\n    echo \"\"\n\n    # 1. 检查热力榜是否存在\n    if [[ ! -f \"$HEATLIST\" ]]; then\n        err \"热力榜不存在：$HEATLIST\"\n        info \"请先运行 'bash sync-memory.sh refresh' 或联系主 agent 生成热力榜\"\n        exit 1\n    fi\n\n    # 2. 检查 scene_blocks 目录\n    if [[ ! -d \"$SCENE_BLOCKS\" ]]; then\n        err \"场景记忆目录不存在：$SCENE_BLOCKS\"\n        exit 1\n    fi\n\n    # 3. 读取并显示热力榜摘要\n    info \"📊 热力榜版本信息：\"\n    grep \"最后更新\" \"$HEATLIST\" | head -1\n    grep \"榜单周期\" \"$HEATLIST\" | head -1\n    echo \"\"\n\n    # 4. 提取 TOP10 列表\n    echo -e \"  ${BOLD}🥇 当前热力榜 TOP10：${RESET}\"\n    local count=1\n    while IFS= read -r title; do\n        [[ -z \"$title\" ]] && continue\n        echo -e \"    ${count}. ${GREEN}${title}${RESET}\"\n        ((count++))\n    done < <(extract_top_blocks \"$HEATLIST\")\n    echo \"\"\n\n    # 5. 本地缺失检查\n    local missing\n    mapfile -t missing < <(find_missing_blocks \"$HEATLIST\" \"$MEMORY\")\n\n    echo -e \"  ${BOLD}📋 本地 MEMORY.md 同步状态：${RESET}\"\n    if [[ ${#missing[@]} -eq 0 ]]; then\n        echo -e \"    ${GREEN}✅ 本地已覆盖全部 TOP10 知识块，无需额外读取${RESET}\"\n    else\n        echo -e \"    ${YELLOW}⚠️  发现 ${#missing[@]} 个热力榜知识块本地缺失${RESET}\"\n        echo \"\"\n        echo -e \"  ${BOLD}📖 建议读取以下知识块：${RESET}\"\n        for title in \"${missing[@]}\"; do\n            local summary\n            summary=$(get_block_summary \"$title\" \"$SCENE_BLOCKS\")\n            local source_file=\"$SCENE_BLOCKS/${title}.md\"\n            echo \"\"\n            echo -e \"    ${RED}✦ ${title}${RESET}\"\n            echo -e \"       摘要：${summary}\"\n            if [[ -f \"$source_file\" ]]; then\n                echo -e \"       路径：${source_file}\"\n                echo -e \"       操作：${CYAN}read \\\"$source_file\\\"${RESET} 后补充至本地 MEMORY.md\"\n            else\n                echo -e \"       状态：⚠️ 源文件不存在，可能已整合至其他文档\"\n            fi\n        done\n        echo \"\"\n        info \"读取完成后，建议将知识块标题追加至本地 MEMORY.md 的「热度知识块」章节\"\n        info \"格式示例：- ${title}（来源：热力榜 TOP${#missing[@]}，同步日期：${TIMESTAMP}）\"\n    fi\n\n    echo \"\"\n    echo -e \"${BOLD}═══════════════════════════════════════════════════════${RESET}\"\n    echo -e \"  检查完成  ·  $TIMESTAMP\"\n    echo -e \"${BOLD}═══════════════════════════════════════════════════════${RESET}\"\n    echo \"\"\n    info \"提示：使用 'bash sync-memory.sh diff' 可快速查看差异\"\n    info \"提示：使用 'bash sync-memory.sh refresh' 可刷新热力榜引用\"\n}\n\n#------------------------------------------------------------\n# 主入口\n#------------------------------------------------------------\ncase \"${1:-check}\" in\n    refresh)\n        cmd_refresh \"$@\"\n        ;;\n    diff)\n        cmd_diff\n        ;;\n    check|\"\")\n        cmd_check\n        ;;\n    *)\n        err \"未知命令：$1\"\n        echo \"用法：\"\n        echo \"  bash sync-memory.sh          # 检查缺失知识块\"\n        echo \"  bash sync-memory.sh diff      # 显示与本地 MEMORY.md 差异\"\n        echo \"  bash sync-memory.sh refresh   # 刷新热力榜引用\"\n        exit 1\n        ;;\nesac\n"}],"isError":false,"timestamp":1775900442840}}
