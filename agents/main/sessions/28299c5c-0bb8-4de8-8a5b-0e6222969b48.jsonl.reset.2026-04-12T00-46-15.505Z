u_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"ZqBOdEQ1konUk7xlLurc0UKFnMd","type":"docx","url":"https://delonix.feishu.cn/docx/ZqBOdEQ1konUk7xlLurc0UKFnMd"},{"created_time":"1670922830","modified_time":"1670922830","name":"质量提升考核方案20220812.xlsx","owner_id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"boxcn9Ms2syedINrwILlkjx77Xf","type":"file","url":"https://delonix.feishu.cn/file/boxcn9Ms2syedINrwILlkjx77Xf"},{"created_time":"1670809837","modified_time":"1670809957","name":"关于天津项目申请减免租金的函件20221212","owner_id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"RwOBdHPl7oifgIxyPAdcReP6nIc","type":"docx","url":"https://delonix.feishu.cn/docx/RwOBdHPl7oifgIxyPAdcReP6nIc"},{"created_time":"1670809680","modified_time":"1670809680","name":"关于天津项目申请减免租金的函件20221212","owner_id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"UzzsdVkG6oObapxAkEnc3KcLn4W","type":"docx","url":"https://delonix.feishu.cn/docx/UzzsdVkG6oObapxAkEnc3KcLn4W"},{"created_time":"1670809500","modified_time":"1670809500","name":"关于天津项目申请减免租金的函件20221212","owner_id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"QYTndPNvio0KIVx21RgcKVp8n1R","type":"docx","url":"https://delonix.feishu.cn/docx/QYTndPNvio0KIVx21RgcKVp8n1R"},{"created_time":"1670729283","modified_time":"1670729283","name":"会议聊天记录_海油集中观察核酸检测的视频会议_2022.12.11","owner_id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"doccnNSm0wvUoF2QULOyDnAzq2c","type":"doc","url":"https://delonix.feishu.cn/docs/doccnNSm0wvUoF2QULOyDnAzq2c"},{"created_time":"1670568364","modified_time":"1670568558","name":"A直营店经营数据汇总-天津瑞湾","owner_id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","parent_token":"nodcnNLFavdfZFEshUKCm9W92cd","token":"shtcn24pkc7qniNHVVKA8tVpuke","type":"sheet","url":"https://delonix.feishu.cn/shee