       ]\n      },\n      \"record_id\": \"recvfqTjE9Zgdc\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"用户通过自拍视频/语音/图片输入需求，系统自动识别语音内容+画面信息，理解意图执行任务\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"全模态嘴控2.0交互系统\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775023620000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"支持视频/语音/图片/文字多模态输入，自动识别用户意图并执行任务，无需明确指令\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"用户发视频说：\\\"帮我对比手里这份上周价格表和今日的竞品价格\\\"，系统自动识别价格表数据+获取实时价格+生成对比报告\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"自然交互\",\n          \"语音控制\",\n          \"视频分析\",\n          \"自动化任务执行\"\n        ]\n      },\n      \"record_id\": \"recvfqTm7iQRbO\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"调用flyai相关命令，按参数查询所需旅行数据\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"飞猪FlyAI旅行数据对接\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775023680000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"对接飞猪FlyAI开放接口，支持实时查询酒店/机票/景点/价格/评分等全量旅行数据\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"flyai search-hotel --dest-name 天津滨海新区 --check-in-date 2026-03-31\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"酒店价格查询\",\n          \"旅行产品检索\",\n          \"竞品价格监控\",\n          \"旅行报告生成\"\n        ]\n      },\n      \"record_id\": \"recvfqToXOfXBE\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"输入酒店名称自动分析竞品\",\n            \"type