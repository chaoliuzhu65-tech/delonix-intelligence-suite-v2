{"type":"message","id":"0edf49c4","parentId":"f0c228e4","timestamp":"2026-03-19T04:54:15.174Z","message":{"role":"toolResult","toolCallId":"call_function_azy5lgdsc1h8_1","toolName":"read","content":[{"type":"text","text":"{\n  \"meta\": {\n    \"lastTouchedVersion\": \"2026.3.8\",\n    \"lastTouchedAt\": \"2026-03-11T07:55:34.718Z\"\n  },\n  \"wizard\": {\n    \"lastRunAt\": \"2026-03-05T11:15:21.053Z\",\n    \"lastRunVersion\": \"2026.3.2\",\n    \"lastRunCommand\": \"onboard\",\n    \"lastRunMode\": \"local\"\n  },\n  \"update\": {\n    \"checkOnStart\": false\n  },\n  \"browser\": {\n    \"enabled\": true,\n    \"color\": \"#00AA00\",\n    \"executablePath\": \"/usr/bin/chromium-browser\",\n    \"headless\": true,\n    \"noSandbox\": true,\n    \"defaultProfile\": \"openclaw\",\n    \"extraArgs\": [\n      \"--window-size=1920,1080\",\n      \"--test-type\",\n      \"--disable-gpu\",\n      \"--no-sandbox\"\n    ]\n  },\n  \"secrets\": {\n    \"providers\": {\n      \"miaoda-provider\": {\n        \"source\": \"file\",\n        \"path\": \"/home/gem/workspace/.force/openclaw/miaoda-provider-key\",\n        \"mode\": \"singleValue\"\n      }\n    }\n  },\n  \"models\": {\n    \"providers\": {\n      \"miaoda\": {\n        \"baseUrl\": \"https://innerapi.aiforce.cloud/innerapi/api/v1/sgw/model/proxy\",\n        \"apiKey\": {\n          \"source\": \"file\",\n          \"provider\": \"miaoda-provider\",\n          \"id\": \"value\"\n        },\n        \"api\": \"openai-completions\",\n        \"headers\": {\n          \"x-api-key\": \"186899_app_4jpd2jyqtwqgt_preview\"\n        },\n        \"models\": [\n          {\n            \"id\": \"miaoda-model-auto\",\n            \"name\": \"妙搭\",\n            \"reasoning\": true,\n            \"input\": [\n              \"text\"\n            ],\n            \"cost\": {\n              \"input\": 0,\n              \"output\": 0,\n              \"cacheRead\": 0,\n              \"cacheWrite\": 0\n            },\n            \