er","name":"段运法"},"create_time":"2026-02-27T00:32:32+08:00","deleted":false,"updated":false},{"message_id":"om_x100b553316a5b0a4b24bf68334432cc","msg_type":"text","content":"水70地热水461电5720气22余额（23524.99）总费用7150.48","sender":{"id":"ou_1a56a44dab3417bcf45f69ea4b1c3510","sender_type":"user","name":"段运法"},"create_time":"2026-02-27T00:32:06+08:00","deleted":false,"updated":false},{"message_id":"om_x100b553316f364a0b24546acecce496","msg_type":"image","content":"![image](img_v3_02va_7b392fb2-5a28-4cb1-93d2-63da8cb1c96g)","sender":{"id":"ou_1a56a44dab3417bcf45f69ea4b1c3510","sender_type":"user","name":"段运法"},"create_time":"2026-02-27T00:32:04+08:00","deleted":false,"updated":true},{"message_id":"om_x100b56c618197ca4c2ce2aabc1227d0","msg_type":"text","content":"2月25号能耗已提交","sender":{"id":"ou_4aa78e7fb68ee2198677db1f39ec72a9","sender_type":"user","name":"陈献友"},"create_time":"2026-02-26T00:38:05+08:00","deleted":false,"updated":false},{"message_id":"om_x100b56c618d120a0c263001945a33ea","msg_type":"image","content":"![image](img_v3_02v9_f6dd899b-4d58-434a-8958-f978c611997g)","sender":{"id":"ou_4aa78e7fb68ee2198677db1f39ec72a9","sender_type":"user","name":"陈献友"},"create_time":"2026-02-26T00:37:53+08:00","deleted":false,"updated":true},{"message_id":"om_x100b56c61b5af0a0c3480d7b582c6a1","msg_type":"text","content":"水69地热水420电6320气37余额23607.27总费用7525.08","sender":{"id":"ou_4aa78e7fb68ee2198677db1f39ec72a9","sender_type":"user","name":"陈献友"},"create_time":"2026-02-26T00:37:45+08:00","deleted":false,"updated":false},{"message_id":"om_x100b56e8aa4e34a8c38f93ecbc1f9fb","msg_type":"text","content":"2月24号能耗已提交","sender":{"id":"ou_4aa78e7fb68ee2198677db1f39ec72a9","sender_type":"user","name":"陈献友"},"create_time":"2026-02-25T00:14:00+08:00","deleted":false,"updated":false},{"message_id":"om_x100b56e8ad635ca4c2efd3a34c5309d","msg_type":"image","content":"![image](img_v3_02v8_f97000f2-26b6-4151-9c86-4dff80acc13g)","sender":{"id":"ou_4aa78e7fb68ee2198677db1f39ec72a9","sender_type":"user","na