{"type":"message","id":"ddbdab5f","parentId":"42dbb372","timestamp":"2026-04-07T19:02:56.215Z","message":{"role":"toolResult","toolCallId":"call_function_e67nplsa52az_3","toolName":"feishu_im_user_get_messages","content":[{"type":"text","text":"{\n  \"messages\": [\n    {\n      \"message_id\": \"om_x100b522dd87720a0c2a39cefdffc102\",\n      \"msg_type\": \"text\",\n      \"content\": \"@刘东东 @魏安琴 把咱们集团330发布会的链接放上！ 说明ai趋势\",\n      \"sender\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"sender_type\": \"user\",\n        \"name\": \"晁留柱\"\n      },\n      \"create_time\": \"2026-04-05T07:06:19+08:00\",\n      \"deleted\": false,\n      \"updated\": true,\n      \"mentions\": [\n        {\n          \"key\": \"@_user_1\",\n          \"id\": \"ou_1ea58f21699b6576cd93c65ffbc1c22a\",\n          \"name\": \"刘东东\"\n        },\n        {\n          \"key\": \"@_user_2\",\n          \"id\": \"ou_9c9a96e3db30579a7992b6f6aa3e9b3a\",\n          \"name\": \"魏安琴\"\n        }\n      ]\n    },\n    {\n      \"message_id\": \"om_x100b522ddaf2e4a0c30137e07d15862\",\n      \"msg_type\": \"image\",\n      \"content\": \"![image](img_v3_0210f_fcbfa005-395c-43d6-9002-7e1df5bff3eg)\",\n      \"sender\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"sender_type\": \"user\",\n        \"name\": \"晁留柱\"\n      },\n      \"create_time\": \"2026-04-05T07:05:40+08:00\",\n      \"deleted\": false,\n      \"updated\": true\n    },\n    {\n      \"message_id\": \"om_x100b522d139b40a0b21b13824bd02de\",\n      \"msg_type\": \"text\",\n      \"content\": \"@段艳 @赵炳涛 积极处理\",\n      \"sender\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"sender_type\": \"user\",\n        \"name\": \"晁留柱\"\n      },\n      \"create_time\": \"2026-04-05T06:51:01+08:00\",\n      \"deleted\": false,\n      \"updated\": true,\n      \"reply_to\": \"om_x100b522d12eeaca0b2d6a9b096b53f2\",\n      \"mentions\": [\n        {\n          \"key\": \"@_user_