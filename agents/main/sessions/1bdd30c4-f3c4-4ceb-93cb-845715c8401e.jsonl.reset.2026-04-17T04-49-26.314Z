pSecret\\n- **第三方API**：在 https://www.dingdanxia.com 注册获取 API Key 即可使用\"\n            }\n          ],\n          \"api\": \"openai-completions\",\n          \"provider\": \"minimax-token-plan\",\n          \"model\": \"MiniMax-M2.7-highspeed\",\n          \"usage\": {\n            \"input\": 0,\n            \"output\": 0,\n            \"totalTokens\": 0,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1776244556706,\n          \"responseId\": \"062e8a4c3bf1fbc6cf260ee6b68e88d1\",\n          \"__openclaw\": {\n            \"id\": \"7d2d0749\",\n            \"seq\": 69\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:b03afd9b-8a57-4ebd-98ae-5ba35cfec4bd\",\n      \"kind\": \"other\",\n      \"channel\": \"feishu\",\n      \"origin\": {\n        \"provider\": \"heartbeat\"\n      },\n      \"spawnedBy\": \"agent:main:feishu:direct:ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n      \"label\": \"browser-debug\",\n      \"displayName\": \"feishu:g-agent-main-subagent-b03afd9b-8a57-4ebd-98ae-5ba35cfec4bd\",\n      \"parentSessionKey\": \"agent:main:feishu:direct:ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n      \"deliveryContext\": {\n        \"channel\": \"feishu\",\n        \"to\": \"ou_8dd4dc0180a2fb74c692f17b94c94d8e\"\n      },\n      \"updatedAt\": 1776244320483,\n      \"sessionId\": \"c330f329-b540-474e-8d87-55d618eef5f2\",\n      \"model\": \"MiniMax-M2.7-highspeed\",\n      \"contextTokens\": 200000,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1776244037510,\n      \"endedAt\": 1776244282215,\n      \"runtimeMs\": 234318,\n      \"systemSent\": true,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"feishu\",\n      \"lastTo\": \"ou_8dd4dc0180a2fb74c692f17b94c94d8e\",\n      \"transcriptPath\": \"/home/gem/workspace/agent/agents/ma