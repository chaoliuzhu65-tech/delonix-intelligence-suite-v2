ole\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_794fbb18043c6ab0198931c73be2f7c0\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_ab1141136816fdd74d6ff641ed020531\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_578e79726057e3a5e029a05026610ffc\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_c9c7a4bbe688bf65360a4b645ae5f908\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_b789609187e369b00dd5545bd4c7b1ce\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_f6ef0131324054a57a3d62e9c9160486\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_27be669f2f2a77c519c7b8eb52d0fd11\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_b805613811a8e50420d107466e5d9713\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_2688fd620eec15fa4893def8c674294e\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_3c9a6e87c61faea1261c331a30c6c4ad\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_1bd68457cdaf4608263086e4d59aa463\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_2d937e732367654dde9d3c4b72a84036\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_5e6ff58559196aa281b0ce8741f79060\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        }\n      ],\n      \"mode\": 2,\n      \"origin\": {\n        \"href\": {\n          \"title\": \"\",\n          \"url\": \"\"\n        },\n        \"platform_i18n_name\": {\n          \"de_de\": \"\",\n          \"en_us\": \"\",\n          \"es_es\": \"\",\n          \"fr_fr\": \"\",\n          \"it_it\": \"\",\n          \"ja_jp\": \"\",\n          \"ko_kr\": \"\",\n          \"ru_ru\": \"\",\n          \"th_th\": \"\",\n          \"zh_cn\": \"\",\n          \"zh_hk\": \"\",\n          \"zh_tw\": \"\"\n        }\n      },\n      \"parent_task_guid\": \"\",\n      \"repeat_rule\": \"\",\n      \"source\": 2,\n      \"status\": \"done\",\n      \"subtask_count\": 0,\n      \"summary\": \"请我们店总特别提高对集团季度会议最重要的精神传导的学习、认知.并在日常工作中,立即躬身带头使用所有能用的AI工具来为酒店的工作提效,来跟上咱们“AI公司”的核心定位,同时,还要在日常工作中积极的普及全员使用AI. 参考直营店的工作要求:所有向集团侧、事业部级报送的一切邮件、资料、方案、合同一律必须事先发送“AI评估”,连带评估意见一并提报(当然,如果AI评估已经有问题的,建议先自行修订再提报)。我希望咱们区域内的小伙伴也要积极拥抱AI给自己、给团队带来的增效. 并拟于2月份召开一次线上的专题会议,希望每位店总就AI这个维度进行专题的分享,不论是个人的应用体会,还是在日常工作中同事们应用的提效都可以. @所有人 \",\n      \"task_id\": \"t135657\",\n      \"tasklists\": [],\n      \"updated_at\": \"1769829129694\",\n      \"url\": \"https://applink.feishu.cn/client/todo/detail?guid=a64c5e26-6391-4a42-9398-08143f74d958&suite_entity_num=t135657\"\n    },\n    {\n      \"completed_at\": \"1775108126912\",\n      \"created_at\": \"1769319423016\",\n      \"creator\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"type\": \"user\"\n      },\n      \"dependencies\": [],\n      \"description\": \"\",\n      \"extra\": \"\",\n      \"guid\": \"35eb3530-0f88-45b0-bcc4-b225fb253d78\",\n      \"is_milestone\": false,\n      \"members\": [\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_3517b63ffe1238e009b7fc4298ab74f9\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_7473ee6b5d079194d597ca62ce025187\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_7c159b7dbbeedab2b851f1c8446bc1b5\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_3517b63ffe1238e009b7fc4298ab74f9\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_7c159b7dbbeedab2b851f1c8446bc1b5\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_7473ee6b5d079194d597ca62ce025187\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        }\n      ],\n      \"mode\": 2,\n      \"origin\": {\n        \"href\": {\n          \"title\": \"\",\n          \"url\": \"\"\n        },\n        \"platform_i18n_name\": {\n          \"de_de\": \"\",\n          \"en_us\": \"\",\n          \"es_es\": \"\",\n          \"fr_fr\": \"\",\n          \"it_it\": \"\",\n          \"ja_jp\": \"\",\n          \"ko_kr\": \"\",\n          \"ru_ru\": \"\",\n          \"th_th\": \"\",\n          \"zh_cn\": \"\",\n          \"zh_hk\": \"\",\n          \"zh_tw\": \"\"\n        }\n      },\n      \"parent_task_guid\": \"\",\n      \"repeat_rule\": \"\",\n      \"source\": 2,\n      \"status\": \"done\",\n      \"subtask_count\": 0,\n      \"summary\": \"咱们对集团提报70家/周的拜访是没问题的，可以直接嵌入飞书云文档，但是周报以后，三位的外拓计划必须补充到咱们酒店外拓的整体周计划中@孙雪艳  @赵炳涛  @陈雷明  你们三位的外拓不用追求数量！ 要有质量！ 要有大客户开发的思路和方向感出来，至少每个月找到一个为酒店长期增收5-10万的生意机会 ！  不论从线上、线下，竞争对手都行，甚至可以连续1-2个月去蹲守！\",\n      \"task_id\": \"t135508\",\n      \"tasklists\": [],\n      \"updated_at\": \"1775108127188\",\n      \"url\": \"https://applink.feishu.cn/client/todo/detail?guid=35eb3530-0f88-45b0-bcc4-b225fb253d78&suite_entity_num=t135508\"\n    },\n    {\n      \"completed_at\": \"0\",\n      \"created_at\": \"1768890030583\",\n      \"creator\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"type\": \"user\"\n      },\n      \"dependencies\": [],\n      \"description\": \"\",\n      \"extra\": \"\",\n      \"guid\": \"6a88ba63-ab06-4d52-817f-7a2d25dad253\",\n      \"is_milestone\": false,\n      \"members\": [\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_9c9a96e3db30579a7992b6f6aa3e9b3a\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_1ea58f21699b6576cd93c65ffbc1c22a\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_030cf497a5d422b7f507c422bb9aca65\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_3517b63ffe1238e009b7fc4298ab74f9\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_9c9a96e3db30579a7992b6f6aa3e9b3a\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_1ea58f21699b6576cd93c65ffbc1c22a\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_030cf497a5d422b7f507c422bb9aca65\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_3517b63ffe1238e009b7fc4298ab74f9\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        }\n      ],\n      \"mode\": 2,\n      \"origin\": {\n        \"href\": {\n          \"title\": \"\",\n          \"url\": \"\"\n        },\n        \"platform_i18n_name\": {\n          \"de_de\": \"\",\n          \"en_us\": \"\",\n          \"es_es\": \"\",\n          \"fr_fr\": \"\",\n          \"it_it\": \"\",\n          \"ja_jp\": \"\",\n          \"ko_kr\": \"\",\n          \"ru_ru\": \"\",\n          \"th_th\": \"\",\n          \"zh_cn\": \"\",\n          \"zh_hk\": \"\",\n          \"zh_tw\": \"\"\n        }\n      },\n      \"parent_task_guid\": \"\",\n      \"repeat_rule\": \"\",\n      \"source\": 2,\n      \"status\": \"todo\",\n      \"subtask_count\": 0,\n      \"summary\": \"@孙雪艳  @赵炳涛  @陈雷明  @李勋  @张惠  @王鑫  @刘东东  @魏安琴  @夏美娟  要求:你们每个人使用“阿里千问”去下单外卖、下单酒店,晚例会提交使用体验反馈,当然可以自行选择退单退货也行.建议是完整体验一下,不体验没感觉,看看阿里AI底层调用了什么APP,这样就提示我们在哪些APP的信息发布上要有优化! 要有更积极、更有特点的展示! 否则,AI不会帮忙客户进行预订. 再要求:你们用美团开发的”小姜AI助手“下单咱们酒店或者周边的酒店,我刚刚试了,可以随时美团后台退掉的. 这样你们再洞察一下美团上我们产品展示有哪些不足,当然,千问是调用的高德地图和飞猪!   要求,你们全部操作一遍! @田静  (@朱雅静  @郑伟  @姜国军  三位也不建议落后)\",\n      \"task_id\": \"t135256\",\n      \"tasklists\": [],\n      \"updated_at\": \"1768890033543\",\n      \"url\": \"https://applink.feishu.cn/client/todo/detail?guid=6a88ba63-ab06-4d52-817f-7a2d25dad253&suite_entity_num=t135256\"\n    },\n    {\n      \"completed_at\": \"0\",\n      \"created_at\": \"1767497992692\",\n      \"creator\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"type\": \"user\"\n      },\n      \"dependencies\": [],\n      \"description\": \"\",\n      \"extra\": \"\",\n      \"guid\": \"a9507737-6fe9-473e-9455-3f06c45f93a0\",\n      \"is_milestone\": false,\n      \"members\": [\n        {\n          \"id\": \"ou_f18e1427d1c460763c6f3f411bf8b984\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_97d630f90dbf4327a29cbdd301c0ac14\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6