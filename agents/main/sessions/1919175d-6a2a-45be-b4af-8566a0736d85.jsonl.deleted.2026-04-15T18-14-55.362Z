ssignee","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"},{"id":"ou_67ce26a0b436d6b54dcd6c30a26ca241","role":"follower","type":"user"},{"id":"ou_7456dc7ccf01ee36feb7ccb7aca9ec97","role":"follower","type":"user"},{"id":"ou_c043b57400c801eeda3e914a11cb3b28","role":"follower","type":"user"}],"mode":2,"origin":{"href":{"title":"","url":""},"platform_i18n_name":{"de_de":"","en_us":"","es_es":"","fr_fr":"","it_it":"","ja_jp":"","ko_kr":"","ru_ru":"","th_th":"","zh_cn":"","zh_hk":"","zh_tw":""}},"parent_task_guid":"","repeat_rule":"","source":2,"status":"todo","subtask_count":0,"summary":"针对宾客送水这个事儿,就是上述第5条中的内容,需要考虑,要么统一在楼层电梯厅放10箱水,客人自取,要么,改为默认房间节假日一律放10瓶,超10瓶后或收费?2元/瓶?这个要商讨一下方案. 目前我入住过的温州开元名庭就是在电梯厅的桌子上直接摆放几十瓶矿泉水自己取.@孙桂霞  @段艳  @邢振慧 ","task_id":"t125895","tasklists":[],"updated_at":"1743949613723","url":"https://applink.feishu.cn/client/todo/detail?guid=2b41b9d6-c6f6-41c3-ba75-5308be748b2e&suite_entity_num=t125895"},{"completed_at":"0","created_at":"1743923713848","creator":{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","type":"user"},"dependencies":[],"description":"","extra":"","guid":"5e8de303-84f4-4a20-940b-d6234d340d7e","is_milestone":false,"members":[{"id":"ou_030cf497a5d422b7f507c422bb9aca65","role":"assignee","type":"user"},{"id":"ou_67ce26a0b436d6b54dcd6c30a26ca241","role":"assignee","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"assignee","type":"user"},{"id":"ou_64a95e7db51f7f832a39b8643668b4de","role":"assignee","type":"user"},{"id":"ou_97d630f90dbf4327a29cbdd301c0ac14","role":"assignee","type":"user"},{"id":"ou_7456dc7ccf01ee36feb7ccb7aca9ec97","role":"assignee","type":"user"},{"id":"ou_c043b57400c801eeda3e914a11cb3b28","role":"assignee","type":"user"},{"id":"ou_fa790d1435a3f6a9cddf533d6f9dffe4","role":"assignee","type":"user"},{"id":"ou_030cf497a5d422b7f507c422bb9aca65","role":"follower","type":"user"},{"id":"ou_79712565892335b9cf83ff1929ccbcfe","role":"follower","type":"user"},{"id":"ou_64a95e7db51f7f832a39b8643668b4de","role":"follower","type":"user"},{"id":"ou_c043b57400c801eeda3e914a11cb3b28","role":"follower","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"},{"id":"ou_7473ee6b5d079194d597ca62ce025187","role":"follower","type":"user"},{"id":"ou_a55a235a0bcf43280cedb517d4738c52","role":"follower","type":"user"},{"id":"ou_97d630f90dbf4327a29cbdd301c0ac14","role":"follower","type":"user"},{"id":"ou_7456dc7ccf01ee36feb7ccb7aca9ec97","role":"follower","type":"user"},{"id":"ou_67ce26a0b436d6b54dcd6c30a26ca241","role":"follower","type":"user"},{"id":"ou_16644cc67428683ca63416b87bd46924","role":"follower","type":"user"},{"id":"ou_fa790d1435a3f6a9cddf533d6f9dffe4","role":"follower","type":"user"},{"id":"ou_c8ab4fc07499875693fe22aedadf1630","role":"follower","type":"user"}],"mode":2,"origin":{"href":{"title":"","url":""},"platform_i18n_name":{"de_de":"","en_us":"","es_es":"","fr_fr":"","it_it":"","ja_jp":"","ko_kr":"","ru_ru":"","th_th":"","zh_cn":"","zh_hk":"","zh_tw":""}},"parent_task_guid":"","repeat_rule":"","source":2,"status":"todo","subtask_count":0,"summary":"从这次清明节来看后续的客房送水果、点心应调整如下:\n1、不要桔子这类带“核儿”的,避免卫生清洁问题;@段艳  \n2、小柿子、黄瓜剩余较多,说明蔬菜类的适合周中商务客人或者是老人,不适合带小孩子的,这个务必要进行调整;@段艳  \n3、苹果好吃但是外皮粗粗拉拉的难看,让客人以为我们进的是差品;@杨金艳  @朱雅静  \n4、中式点心后续不再配了,东西是好东西,但几乎年轻人或者小孩子都不喜欢;@段艳  @杨金艳  (继续调整新的点心包装标准和设计)@田静  \n5、前台这次没有充足的备好一次性用品,导致客房送物量过大,请楼层根据本次经验,把所有节假日需要用的物资拉出一张清单和预计备量来,明天完成提交,方便立即在前台组织备货;@孙桂霞  @邢振慧  \n6、针对客房节假日排名前五的报修问题,请梳理整改完成方案;@郑伟  @姜国军  \n7、请针对宾客投诉(包括没写到网评里的)全部列出来,逐一开会分析,必须从根儿上解决掉;@邢振慧  @段艳  @孙桂霞  \n8、针对各个班组、每个班次的排班问题梳理整改提升计划(如:本次的中班送物就出现了较大的问题);@邢振慧  @孙桂霞  @段艳  @高五中  @姜国军  @郑伟 ","task_id":"t125894","tasklists":[],"updated_at":"1743927862608","url":"https://applink.feishu.cn/client/todo/detail?guid=5e8de303-84f4-4a20-940b-d6234d340d7e&suite_entity_num=t125894"},{"completed_at":"0","created_at":"1741820921134","creator":{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","type":"user"},"dependencies":[],"description":"","extra":"","guid":"ed9