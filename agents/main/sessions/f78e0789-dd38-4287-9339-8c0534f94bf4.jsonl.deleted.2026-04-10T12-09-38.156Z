{"type":"message","id":"447a9926","parentId":"4080593e","timestamp":"2026-04-09T05:17:32.139Z","message":{"role":"toolResult","toolCallId":"call_function_igo8kmx67qn7_1","toolName":"feishu_im_user_message","content":[{"type":"text","text":"{\n  \"message_id\": \"om_x100b524728705084b346795c5549728\",\n  \"chat_id\": \"oc_36d47adad05d3ca8e93164ebc8bfca40\",\n  \"create_time\": \"1775711852064\"\n}"}],"details":{"message_id":"om_x100b524728705084b346795c5549728","chat_id":"oc_36d47adad05d3ca8e93164ebc8bfca40","create_time":"1775711852064"},"isError":false,"timestamp":1775711852138}}
