{"type":"message","id":"eaa2c5d9","parentId":"ec857bd0","timestamp":"2026-04-17T06:25:24.256Z","message":{"role":"toolResult","toolCallId":"call_function_o5jve7hxk0zv_1","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\n微信公众号文章读取工具\n通过直接访问 mp.weixin.qq.com 读取文章正文内容\n\n使用方法:\n    python3 wechat_article_reader.py <文章 URL>\n    \n示例:\n    python3 wechat_article_reader.py https://mp.weixin.qq.com/s/1w0wAT773G-hTyJe9fe2VA\n\"\"\"\n\nimport sys\nimport requests\nfrom bs4 import BeautifulSoup\nimport re\n\ndef fetch_article(url):\n    \"\"\"获取微信公众号文章内容\"\"\"\n    \n    headers = {\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\n        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',\n        'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',\n    }\n    \n    try:\n        response = requests.get(url, headers=headers, timeout=30)\n        response.raise_for_status()\n        response.encoding = 'utf-8'\n        \n        html = response.text\n        soup = BeautifulSoup(html, 'html.parser')\n        \n        # 提取标题\n        title = \"\"\n        title_tag = soup.find('h1', id='activity-name')\n        if title_tag:\n            title = title_tag.get_text().strip()\n        else:\n            title_tag = soup.find('h2', class_='rich_media_title')\n            if title_tag:\n                title = title_tag.get_text().strip()\n        \n        # 提取公众号名称\n        account_name = \"\"\n        account_tag = soup.find('span', class_='profile_nickname')\n        if account_tag:\n            account_name = account_tag.get_text().strip()\n        \n        # 提取正文内容\n        content_div = soup.find('div', id='js_content')\n        if not content_div:\n            content_div = soup.find('div', class_='rich_media_content')\n        \n        content = \"\"\n        if content_div:\n            # 提取所有段落\n            paragraphs = content_div.find_all(['p', 'section'])\n            for p in paragraphs:\n                text = p.get_text().strip()\n                if text and len(text) > 1:\n                    content += text + \"\\n\\n\"\n        \n        # 提取发布时间\n        publish_date = \"\"\n        date_pattern = r'\\d{4}年\\d{2}月\\d{2}日'\n        date_match = re.search(date_pattern, html)\n        if date_match:\n            publish_date = date_match.group()\n        \n        return {\n            'title': title,\n            'account': account_name,\n            'publish_date': publish_date,\n            'content': content.strip(),\n            'url': url\n        }\n        \n    except requests.exceptions.RequestException as e:\n        return {'error': f'请求失败：{str(e)}'}\n    except Exception as e:\n        return {'error': f'解析失败：{str(e)}'}\n\ndef main():\n    if len(sys.argv) < 2:\n        print(\"使用方法：python3 wechat_article_reader.py <文章 URL>\")\n        print(\"示例：python3 wechat_article_reader.py https://mp.weixin.qq.com/s/xxxxx\")\n        sys.exit(1)\n    \n    url = sys.argv[1]\n    print(f\"正在读取文章：{url}\\n\")\n    \n    result = fetch_article(url)\n    \n    if 'error' in result:\n        print(f\"❌ {result['error']}\")\n        sys.exit(1)\n    \n    print(\"=\" * 60)\n    print(f\"📰 标题：{result['title']}\")\n    print(f\"📝 公众号：{result['account']}\")\n    if result['publish_date']:\n        print(f\"📅 发布时间：{result['publish_date']}\")\n    print(f\"🔗 链接：{result['url']}\")\n    print(\"=\" * 60)\n    print(\"\\n【正文内容】\\n\")\n    print(result['content'])\n    print(\"\\n\" + \"=\" * 60)\n    print(f\"全文共 {len(result['content'])} 字\")\n\nif __name__ == '__main__':\n    main()\n"}],"isError":false,"timestamp":1776407124213}}
{"type":"message","id":"d81b147d","parentId":"eaa2c5d9","timestamp":"2026-04-17T06:25:39.042Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"The script is returning empty content because the article might require additional headers or the content is loaded dynamically. Let me try adding some additional headers or cookies that might be needed. Actually, let me first check what the HTML response looks like to understand why it's not finding the content."},{"type":"toolCall","id":"call_function_vkdrg80xzw3e_1","name":"exec","arguments":{"command":"python3 -c \"\nimport requests\nfrom bs4 import BeautifulSoup\n\nurl = 'https://mp.weixin.qq.com/s/C8z5urfTfZrvHLzBKya_XA'\nheaders = {\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\n    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',\n    'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',\n}\nresp = requests.get(url, headers=headers, timeout=30)\nprint('Status:', resp.status_code)\nsoup = BeautifulSoup(resp.text, 'html.parser')\n# Check for js_content\ndiv = soup.find('div', id='js_content')\nprint('js_content found:', div is not None)\n# Check for rich_media_content  \ndiv2 = soup.find('div', class_='rich_media_content')\nprint('rich_media_content found:', div2 is not None)\n# Check title\ntitle = soup.find('h1', id='activity-name')\nprint('Title:', title.get_text().strip() if title else 'Not found')\n# Check account\naccount = soup.find('span', class_='profile_nickname')\nprint('Account:', account.get_text().strip() if account else 'Not found')\n# Print first 2000 chars of html\nprint('HTML snippet:', resp.text[:2000])\n\" 2>&1","timeout":30}}],"api":"openai-completions","provider":"minimax-token-plan","model":"MiniMax-M2.7-highspeed","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776407124258,"responseId":"0631055463ad47b7e31710061126d7fa"}}
