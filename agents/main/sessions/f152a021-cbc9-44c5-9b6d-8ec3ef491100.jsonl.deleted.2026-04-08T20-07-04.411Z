{"type":"message","id":"b4698685","parentId":"8cdef222","timestamp":"2026-04-07T20:03:18.375Z","message":{"role":"toolResult","toolCallId":"call_function_sr56awuxle73_1","toolName":"feishu_im_user_get_messages","content":[{"type":"text","text":"{\n  \"messages\": [\n    {\n      \"message_id\": \"om_x100b8970e30314c00f1364d6b9ac418\",\n      \"msg_type\": \"text\",\n      \"content\": \"这几天开始平台订房了，来拜访一下，促进感情，看看能否支摊儿\",\n      \"sender\": {\n        \"id\": \"ou_be65a652ab913c8f90e6c0ac1ded1fe8\",\n        \"sender_type\": \"user\",\n        \"name\": \"张惠\"\n      },\n      \"create_time\": \"2023-05-17T11:32:45+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b8970e54bc8800f256113016eff7\",\n      \"msg_type\": \"image\",\n      \"content\": \"![image](img_v2_33a43ec3-e0b0-47d6-b856-f1cfff7c010g)\",\n      \"sender\": {\n        \"id\": \"ou_be65a652ab913c8f90e6c0ac1ded1fe8\",\n        \"sender_type\": \"user\",\n        \"name\": \"张惠\"\n      },\n      \"create_time\": \"2023-05-17T11:32:08+08:00\",\n      \"deleted\": false,\n      \"updated\": true\n    },\n    {\n      \"message_id\": \"om_x100b8970e7af68e80f1d6b6be1e8bc2\",\n      \"msg_type\": \"image\",\n      \"content\": \"![image](img_v2_3e6673e2-2620-488c-a63b-05b9a907226g)\",\n      \"sender\": {\n        \"id\": \"ou_be65a652ab913c8f90e6c0ac1ded1fe8\",\n        \"sender_type\": \"user\",\n        \"name\": \"张惠\"\n      },\n      \"create_time\": \"2023-05-17T11:31:34+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b8cc3ded504bc0f289bf09f3ef30\",\n      \"msg_type\": \"text\",\n      \"content\": \"领导，我在五楼接待明天国家管网团队领导了@晁留柱\",\n      \"sender\": {\n        \"id\": \"ou_be65a652ab913c8f90e6c0ac1ded1fe8\",\n        \"sender_type\": \"user\",\n        \"name\": \"张惠\"\n      },\n      \"create_time\": \"2023-04-19T13:15:45+08:00\",\n      \"deleted\": false,\n      \"updated\": false,\n