5631e6\",\n        \"sender_type\": \"user\",\n        \"name\": \"徐玲\"\n      },\n      \"create_time\": \"2026-04-03T09:20:05+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b53c512cca4b0b4c02316b4f9d39\",\n      \"msg_type\": \"image\",\n      \"content\": \"![image](img_v3_0210d_85a50031-a589-4c6b-a0a5-5862412411cg)\",\n      \"sender\": {\n        \"id\": \"ou_3a83abe642b8d77bd513672ca05631e6\",\n        \"sender_type\": \"user\",\n        \"name\": \"徐玲\"\n      },\n      \"create_time\": \"2026-04-03T09:20:00+08:00\",\n      \"deleted\": false,\n      \"updated\": true\n    },\n    {\n      \"message_id\": \"om_x100b53c56a7e0ca8b287aa648924017\",\n      \"msg_type\": \"text\",\n      \"content\": \"关于1518房间更换2005事宜，已经和刘总沟通过，客户为酒店长期住店客户且协助购买138会员卡3张，故免费升级房间，请协助做好换房。\",\n      \"sender\": {\n        \"id\": \"ou_7c159b7dbbeedab2b851f1c8446bc1b5\",\n        \"sender_type\": \"user\",\n        \"name\": \"陈雷明\"\n      },\n      \"create_time\": \"2026-04-03T09:05:15+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b53c49213b96cc2cdc43b0b8738d\",\n      \"msg_type\": \"text\",\n      \"content\": \"This message was recalled\",\n      \"sender\": {\n        \"id\": \"ou_fa790d1435a3f6a9cddf533d6f9dffe4\",\n        \"sender_type\": \"user\",\n        \"name\": \"朱雅静\"\n      },\n      \"create_time\": \"2026-04-03T08:46:06+08:00\",\n      \"deleted\": true,\n      \"updated\": true\n    },\n    {\n      \"message_id\": \"om_x100b53c496a04cb0c22aff85c5230f8\",\n      \"msg_type\": \"text\",\n      \"content\": \"@徐玲 你们搬。\",\n      \"sender\": {\n        \"id\": \"ou_7473ee6b5d079194d597ca62ce025187\",\n        \"sender_type\": \"user\",\n        \"name\": \"赵炳涛\"\n      },\n      \"create_time\": \"2026-04-03T08:44:54+08:00\",\n      \"deleted\": false,\n      \"updated\": true,\n      \"reply_to\": \"om_x100b53c4810348acc11f7897c12e1f3\",\n      \