{"type":"message","id":"d0658f46","parentId":"bc301670","timestamp":"2026-04-14T19:11:18.057Z","message":{"role":"toolResult","toolCallId":"call_function_qbrark90gic0_1","toolName":"feishu_task_task","content":[{"type":"text","text":"{\n  \"tasks\": [\n    {\n      \"completed_at\": \"0\",\n      \"created_at\": \"1775867312696\",\n      \"creator\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"type\": \"user\"\n      },\n      \"dependencies\": [],\n      \"description\": \"请于每周五中午前完成当周相关经营数据提交，EBITDA预测填写链接：https://delonix.feishu.cn/sheets/DufXsa9C2hdwGAtkwcBcfAKznXe\",\n      \"due\": {\n        \"is_all_day\": false,\n        \"timestamp\": \"1830225600000\"\n      },\n      \"extra\": \"\",\n      \"guid\": \"647ce567-cea4-4460-a897-44a36d5a8d68\",\n      \"is_milestone\": false,\n      \"members\": [\n        {\n          \"id\": \"ou_fa790d1435a3f6a9cddf533d6f9dffe4\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_3517b63ffe1238e009b7fc4298ab74f9\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n          \"role\": \"assignee\",\n          \"type\": \"user\"\n        }\n      ],\n      \"mode\": 2,\n      \"origin\": {\n        \"href\": {\n          \"title\": \"workbuddy应用机器人\",\n          \"url\": \"\"\n        },\n        \"platform_i18n_name\": {\n          \"de_de\": \"workbuddy应用机器人\",\n          \"en_us\": \"workbuddy应用机器人\",\n          \"es_es\": \"workbuddy应用机器人\",\n          \"fr_fr\": \"workbuddy应用机器人\",\n          \"it_it\": \"workbuddy应用机器人\",\n          \"ja_jp\": \"workbuddy应用机器人\",\n          \"ko_kr\": \"workbuddy应用机器人\",\n          \"ru_ru\": \"workbuddy应用机器人\",\n          \"th_th\": \"workbuddy应用机器人\",\n          \"zh_cn\": \"workbuddy应用机器人\",\n          \"zh_hk\": \"workbuddy应用机器人\",\n          \"zh_tw\": \"workbuddy应用机器人\"\n        }\n      },\n   