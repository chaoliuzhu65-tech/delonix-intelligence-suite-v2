ecord_id\": \"recvg0FnWq4efH\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"调用miaoda-doc-parse工具进行文档解析\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"miaoda-doc-parse 文档智能解析\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775347200000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"使用IDP智能文档解析将PDF/Word/Excel/PPT转换为Markdown。触发词：文档解析、解析文档、提取文档内容。\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"解析这个PDF文件：xxx.pdf\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"文档解析\",\n          \"PDF转Markdown\",\n          \"Word解析\",\n          \"表格提取\"\n        ]\n      },\n      \"record_id\": \"recvg0FpEsF6E0\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"调用miaoda-image-understanding工具进行图片理解\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"miaoda-image-understanding 图片理解\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775347200000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"AI图像理解与分析。支持图片URL和本地文件路径输入，识别图片内容、场景、人物等。触发词：图片理解、图片分析、图片描述、识别图片。\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"看看这张图片里有什么：xxx.jpg\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"图片理解\",\n          \"图像分析\",\n          \"内容识别\",\n          \"图片描述\"\n        ]\n      },\n      \"record_id\": \"recvg0FrMhZV4A\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"调用miaoda-speech-to-text工具进行语音识别\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"miaoda-speech-to-text 语音转文字\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775347200000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"语音转文字。支持多种语言，将音频/语音转换为文本。触发词：语音转文字、音频转文字、语音识别、speech to text。\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"把这个录音转成文字：xxx.mp3\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"语音转文字\",\n          \"音频转文字\",\n          \"会议录音转写\",\n          \"语音识别\"\n        ]\n      },\n\n⚠️ [... middle content omitted — showing head and tail ...]\n\n          {\n            \"text\": \"【核心】多AI伙伴主群\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1744080000000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"所有AI伙伴都在这个群协同工作：oc_36d47adad05d3ca8e93164ebc8bfca40。成员：arkclaw版openclaw、QclawAI助手、腾讯云Openclaw机器人、workbuddy应用机器人、小柱（本机）。日常汇报→小柱，战略→晁留柱\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"多AI协同\",\n          \"飞书Bot开发\",\n          \"工作流自动化\"\n        ]\n      },\n      \"record_id\": \"recvgcz6IUVL3A\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"点击链接直接访问使用，或导入到本地Agent体系复用能力\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"CodeBuddy共享Agent能力链接\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775796420000,\n        \"研发AI\": \"社区推荐\",\n        \"能力描述\": [\n          {\n            \"text\": \"CodeBuddy平台共享的外部Agent能力，可直接复用该Agent的技能与能力，支持多场景调用\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"https://codebuddy.work/agents/share/Wn04htdgSOF7oiyAKL2VUHD2ovUWM