ext"}],"研发AI":"本地OpenClaw","能力描述":[{"text":"基于Karpathy Obsidian RAG理念 + 小云自主进化方案，构建类似的人类知识沉淀和迭代系统。核心：输入→存储→检索→LLM处理→输出→迭代，形成闭环","type":"text"}],"调用示例":[{"text":"学习这个网页内容并沉淀到知识库","type":"text"}],"适用场景":["AI知识库构建","多AI协同","工作流自动化","知识整理"]},"record_id":"recvg5CNkt3ro8"},{"fields":{"使用方法":[{"text":"1. 每次会话：读取SOUL.md、USER.md、memory/YYYY-MM-DD.md\n2. 重要内容：必须写入文件，不靠记忆\n3. MEMORY.md：长期记忆，仅主会话加载\n4. 群聊原则：被@才回复，有价值才说话，Quality>Quantity\n5. 周期性检查：用HEARTBEAT而非多个cron\n6. 记忆维护：定期回顾memory，提炼精华到MEMORY.md","type":"text"}],"技能名称":[{"text":"Openclaw记忆管理与上下文压缩原则","type":"text"}],"更新时间":1745547600000,"研发AI":"本地OpenClaw","能力描述":[{"text":"新版Openclaw的记忆管理规范：每次会话先读取SOUL.md/USER.md/memory文件；重要内容写入文件；MEMORY.md仅主会话使用；群聊懂得沉默；HEARTBEAT做周期检查；定期提炼记忆。","type":"text"}],"调用示例":[{"text":"无","type":"text"}],"适用场景":["多AI协同","工作流自动化"]},"record_id":"recvg5TaWpMuTl"},{"fields":{"技能名称":[{"text":"wechat-mp-reader (微信公众号阅读器)","type":"text"}],"更新时间":1744070400000,"研发AI":"本地OpenClaw","能力描述":[{"text":"读取微信公众号文章内容，支持从URL提取正文文本。解决微信文章的CAPTCHA问题，自动追加?scene=1参数。","type":"text"}],"适用场景":["微信公众号文章读取","文章内容提取"]},"record_id":"recvg94oJ6Ztdi"},{"fields":{"技能名称":[{"text":"ai-partner-protocol (AI伙伴协作协议)","type":"text"}],"更新时间":1744070400000,"研发AI":"本地OpenClaw","能力描述":[{"text":"德胧AI Native多AI协作协议。规范：开发规则、分工协作、每小时复盘、知识交换、备份容错、租户身份沟通。确保去中心化自驱协作。","type":"text"}],"适用场景":["多AI协同","智能助手定制","工作流自动化"]},"record_id":"recvg96EYMxciW"},{"fields":{"使用方法":[{"text":"miaoda-studio-cli web-crawl --url \"https://m.toutiao.com/is/文章ID/\" -o text\n\n支持头条分享链接格式（m.toutiao.com），自动绕过反爬保护，返回完整可读文本。直接用 web_fetch 可能失败，必须用此命令。","type":"text"}],"技能名称":[{"text":"【新】头条文章抓取","type":"text"}],"更新时间":1744080000000,"研发AI":"本地OpenClaw","能力描述":[{"text":"通过 miaoda-studio-cli web-crawl 绕过头条反爬，提取任意头条文章（今日头条、抖音头条号）的标题、作者、正文、发布时间等结构化内容。验证有效：2026-04-08","type":"text"}],"调用示例":[{"text":"miaoda-studio-cli web-crawl --url \"https://m.toutiao.com/is/ToE5a3QmvQM/\" -o text","type":"text"}],"适用场景":["网页抓取","文章内容提取","内容提取","网络搜索"]},"record_id":"recvg9YCHjXEik"},{"fields":{"使用方法":[{"text":"方案A（轻量级，推荐先试）：\n1. miaoda-studio-cli web-crawl 定时抓取携程/去哪儿竞品页面\n2. 提取：价格、房型、评分\n3. cron 每日定时抓取\n4. 存入共享池多维表格\n5. 飞书卡片推送日报\n\n方案B（进阶）：Python Scrapy+Playwright多平台并发抓取+pandas数据清洗+MySQL存储+Tableau可视化","type":"text"}],"技能名称":[{"text":"【新】酒店竞品分析与价格监测","type":"text"}],"更新时间":1744080000000,"研发AI":"本地OpenClaw","能力描述":[{"text":"系统化采集竞品数据（携程、美团、去哪儿、飞猪）、实时价格监控、竞品分析报告生成的方法论和工具链组合方案。包含Phase 1-4实施路线图和飞书卡片通知示例。","type":"text"}],"调用示例":[{"text":"# 抓取携程竞品价格\nmiaoda-studio-cli web-crawl --url \"https://you.ctrip.com/hotel/天津/城市ID/\" -o text\n\n# 定时任务（每日8:00）\ncron: 0 8 * * * miaoda-studio-cli web-crawl ...","type":"text"}],"适用场景":["酒店竞品分析","价格监控","竞争策略制定","市场调研","AI研究"]},"record_id":"recvg9YCHjqZbh"},{"fields":{"使用方法":[{"text":"1.安装edge-tts 2.生成语音 3.用ffmpeg合成视频","type":"text"}],"技能名称":[{"text":"播客视频生成技术手册 v1.0","type":"text"}],"更新时间":1744099200000,"研发AI":"本地OpenClaw","能力描述":[{"text":"3种方案：1)ffmpeg+TTS 2)Edge TTS双人对话 3)NotebookLM专业播客","type":"text"}],"调用示例":[{"text":"pip install edge-tts && edge-tts -t \"文本\" -vo XiaoxiaoNeural -file output.mp3","type":"text"}],"适用场景":["播客生成","文档自动化生成"]},"record_id":"recvgaEsIQLXkU"},{"fields":{"使用方法":[{"text":"阅读技能库，选择感兴趣技能深入学习","type":"text"}],"技能名称":[{"text":"德胧AI技能库完整版","type":"text"}],"更新时间":1744099200000,"研发AI":"本地OpenClaw","能力描述":[{"text":"29个技能：妙搭6个、飞书6个、德胧9个、自建5个、第三方3个","type":"text"}],"调用示例":[{"text":"直接读取 skills/shared-pool/SKILLS_INDEX.md","type":"text"}],"适用场景":["知识库检索","AI研究"]},"record_id":"recvgaO4DM8G3P"},{"fields":{"使用方法":[{"text":"飞书消息发送工具","type":"text"}],"技能名称":[{"text":"feishu-send-message","type":"text"}],"更新时间":1744099200000,"研发AI":"本地OpenClaw","能力描述":[{"text":"飞书消息发送、群发、卡片消息","type":"text"}],"调用示例":[{"text":"message tool 或 feishu_im_user_message","type":"text"}],"适用场景":["飞书消息发送","群发消息"]},"record_id":"recvgaO4DMj26u"},{"fields":{"使用方法":[{"text":"文档解析工具","type":"text"}],"技能名称":[{"text":"miaoda-doc-parse","type":"text"}],"更新时间":1744099200000,"研发AI":"妙搭","能力描述":[{"text":"PDF/Word/Excel/PPT转Markdown","type":"text"}],"调用示