type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"多AI协同\",\n          \"自动化任务执行\",\n          \"知识整理\",\n          \"信息检索\"\n        ]\n      },\n      \"record_id\": \"recvghIx5dpQWd\"\n    },\n    {\n      \"fields\": {\n        \"使用方法\": [\n          {\n            \"text\": \"1. 底层适配MCP协议 2. 核心编排用CrewAI 3. 复杂场景用AutoGen补充\",\n            \"type\": \"text\"\n          }\n        ],\n        \"技能名称\": [\n          {\n            \"text\": \"德胧AI Native底层架构开源优先方案v2.0\",\n            \"type\": \"text\"\n          }\n        ],\n        \"更新时间\": 1775729940000,\n        \"研发AI\": \"本地OpenClaw\",\n        \"能力描述\": [\n          {\n            \"text\": \"完全放弃自研，100%采用MCP协议+CrewAI+AutoGen开源框架的底层架构方案，零开发成本，高稳定性，强扩展能力\",\n            \"type\": \"text\"\n          }\n        ],\n        \"调用示例\": [\n          {\n            \"text\": \"CrewAI定义角色、任务、流程即可自动生成多Agent协作任务\",\n            \"type\": \"text\"\n          }\n        ],\n        \"适用场景\": [\n          \"多AI协同\",\n          \"自动化任务执行\",\n          \"AI框架选型\",\n          \"架构设计\"\n        ]\n      },\n      \"record_id\": \"recvghV8HYQg4k\"\n    }\n  ],\n  \"has_more\": false,\n  \"total\": 128\n}\n\n⚠️ [Content truncated during persistence — original exceeded size limit. Use offset/limit parameters or request specific sections for large content.]"}],"details":{"records":[{"fields":{"使用方法":[{"text":"1. 接收URL/文档token 2. 对应调用feishu_fetch_doc/feishu_search_doc_wiki/feishu_create_doc/feishu_update_doc工具","type":"text"}],"技能名称":[{"text":"飞书文档全能力处理","type":"text"}],"更新时间":1775023500000,"研发AI":"本地OpenClaw","能力描述":[{"text":"掌握飞书文档的读取、搜索、创建、更新全流程操作，支持docx/表格/知识库等所有格式","type":"text"}],"调用示例":[{"text":"帮我读取这个飞书文档：xxx链接","type":"text"}],"适用场景":["飞书文档处理","知识库检索","文档自动化生成","文档更新维护"]},"record_id":"recvfqThbyxlIJ"},{"fields":{"使用方法":[{"text":"输入目标酒店名称+基础信息，自动生成竞品列表和价格对比报告","type":"text"}],"技能名称":[{"text":"酒店竞品分析V2.0","type":"text"}],"更新时间":1775023560000,"研发AI":"本地OpenClaw","能力描述":[{"text":"酒店竞品筛选逻辑升级，匹配精准度98