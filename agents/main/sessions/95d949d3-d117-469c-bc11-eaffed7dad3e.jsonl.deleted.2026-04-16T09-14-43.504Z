79a7992b6f6aa3e9b3a","role":"follower","type":"user"},{"id":"ou_1ea58f21699b6576cd93c65ffbc1c22a","role":"follower","type":"user"},{"id":"ou_030cf497a5d422b7f507c422bb9aca65","role":"follower","type":"user"},{"id":"ou_3517b63ffe1238e009b7fc4298ab74f9","role":"follower","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"}],"mode":2,"origin":{"href":{"title":"","url":""},"platform_i18n_name":{"de_de":"","en_us":"","es_es":"","fr_fr":"","it_it":"","ja_jp":"","ko_kr":"","ru_ru":"","th_th":"","zh_cn":"","zh_hk":"","zh_tw":""}},"parent_task_guid":"","repeat_rule":"","source":2,"status":"todo","subtask_count":0,"summary":"@孙雪艳  @赵炳涛  @陈雷明  @李勋  @张惠  @王鑫  @刘东东  @魏安琴  @夏美娟  要求:你们每个人使用“阿里千问”去下单外卖、下单酒店,晚例会提交使用体验反馈,当然可以自行选择退单退货也行.建议是完整体验一下,不体验没感觉,看看阿里AI底层调用了什么APP,这样就提示我们在哪些APP的信息发布上要有优化! 要有更积极、更有特点的展示! 否则,AI不会帮忙客户进行预订. 再要求:你们用美团开发的”小姜AI助手“下单咱们酒店或者周边的酒店,我刚刚试了,可以随时美团后台退掉的. 这样你们再洞察一下美团上我们产品展示有哪些不足,当然,千问是调用的高德地图和飞猪!   要求,你们全部操作一遍! @田静  (@朱雅静  @郑伟  @姜国军  三位也不建议落后)","task_id":"t135256","tasklists":[],"updated_at":"1768890033543","url":"https://applink.feishu.cn/client/todo/detail?guid=6a88ba63-ab06-4d52-817f-7a2d25dad253&suite_entity_num=t135256"},{"completed_at":"0","created_at":"1767497992692","creator":{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","type":"user"},"dependencies":[],"description":"","extra":"","guid":"a9507737-6fe9-473e-9455-3f06c45f93a0","is_milestone":false,"members":[{"id":"ou_f18e1427d1c460763c6f3f411bf8b984","role":"assignee","type":"user"},{"id":"ou_97d630f90dbf4327a29cbdd301c0ac14","role":"assignee","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"assignee","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"},{"id":"ou_f18e1427d1c460763c6f3f411bf8b984","role":"follower","type":"user"},{"id":"ou_97d630f90dbf4327a29cbdd301c0ac14","role":"follower","type":"user"}],"mode":2,"origin":{"href":{"title":"","url":""},"platform_i18n_name":{"de_de":"","en_us":"","es_es":"","fr_f