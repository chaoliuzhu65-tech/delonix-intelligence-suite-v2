"extra":"","guid":"72b7c538-cdd7-42ca-a54c-712d5747570d","is_milestone":false,"members":[{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"assignee","type":"user"},{"id":"ou_1ea58f21699b6576cd93c65ffbc1c22a","role":"assignee","type":"user"},{"id":"ou_7456dc7ccf01ee36feb7ccb7aca9ec97","role":"assignee","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"},{"id":"ou_1ea58f21699b6576cd93c65ffbc1c22a","role":"follower","type":"user"},{"id":"ou_7456dc7ccf01ee36feb7ccb7aca9ec97","role":"follower","type":"user"}],"mode":2,"origin":{"href":{"title":"","url":""},"platform_i18n_name":{"de_de":"","en_us":"","es_es":"","fr_fr":"","it_it":"","ja_jp":"","ko_kr":"","ru_ru":"","th_th":"","zh_cn":"","zh_hk":"","zh_tw":""}},"parent_task_guid":"","repeat_rule":"","source":2,"status":"todo","subtask_count":0,"summary":"即日起,大堂1小时的同事们必须掌握这种基础的客房需求的达成,当楼层没有第一时间回应的时候,如果前台没有那么紧张、繁忙应该第一时间安排1小时的同事去房间解决宾客问题! 如果前台入住环节繁忙走不开就由MOD联系当值其他同事跑去现场解决,不论哪个场景下,都应该是以宾客第一时间达成需求为要务,而不是说谁的活谁负责,这样就容易造成扯皮而最终损坏的是宾客的等候、差评!@邢振慧  @刘东东  这些基础性的工作都是你们需要亲自带教的内容.","task_id":"t129651","tasklists":[],"updated_at":"1755674138345","url":"https://applink.feishu.cn/client/todo/detail?guid=72b7c538-cdd7-42ca-a54c-712d5747570d&suite_entity_num=t129651"},{"completed_at":"0","created_at":"1753081023154","creator":{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","type":"user"},"dependencies":[],"description":"","extra":"","guid":"675def1c-df4d-429f-95f0-31e1333f466f","is_milestone":false,"members":[{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"assignee","type":"user"},{"id":"ou_67ce26a0b436d6b54dcd6c30a26ca241","role":"assignee","type":"user"},{"id":"ou_b96327e73fcd6743ef0f7f7e7d06d0d2","role":"assignee","type":"user"},{"id":"ou_fa790d1435a3f6a9cddf533d6f9dffe4","role":"assignee","type":"user"},{"id":"ou_b96327e73fcd6743ef0f7f7e7d06d0d2","role":"follower","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"},{"id":"ou_67ce26a0b436d6b54dcd6c30a26ca241","