":[],"updated_at":"1726277614459","url":"https://applink.feishu.cn/client/todo/detail?guid=814c26b1-4828-49db-b96a-47f1cf5d5d3b&suite_entity_num=t120641"},{"completed_at":"0","created_at":"1708481849291","creator":{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","type":"user"},"dependencies":[],"description":"","extra":"","guid":"2f12eee8-5d5a-4ace-9f83-b8046a7caf82","is_milestone":false,"members":[{"id":"ou_b3c14a4fdda7773cdb045698d001962c","role":"assignee","type":"user"},{"id":"ou_030cf497a5d422b7f507c422bb9aca65","role":"assignee","type":"user"},{"id":"ou_898a11c95f92d39b7cdd35b39421df98","role":"assignee","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"assignee","type":"user"},{"id":"ou_030cf497a5d422b7f507c422bb9aca65","role":"follower","type":"user"},{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","role":"follower","type":"user"},{"id":"ou_b3c14a4fdda7773cdb045698d001962c","role":"follower","type":"user"},{"id":"ou_898a11c95f92d39b7cdd35b39421df98","role":"follower","type":"user"}],"mode":2,"origin":{"href":{"title":"","url":""},"platform_i18n_name":{"de_de":"","en_us":"","es_es":"","fr_fr":"","it_it":"","ja_jp":"","ko_kr":"","ru_ru":"","th_th":"","zh_cn":"","zh_hk":"","zh_tw":""}},"parent_task_guid":"","repeat_rule":"","source":2,"status":"todo","subtask_count":0,"summary":"从散客视角出发，来到异地，一定要从网上看周边的餐厅，哪些是排名靠前，得分高的，咱们自己出门也是这样的选择方式，则我们需要特别重视各种客人常用的”筛选“餐厅的平台（大众点评、美团、小红书）去主动运营、提升我们的各类排名、网评分！@所有人  客人能刷到我们才会选择我们，如果客人看不到我们的排名，根本就不知道我们酒店还有一个非常好的餐厅。@田静  @孙红格  @冯美田  本日抽空开个沟通会，按照集团针对名都酒店餐厅网评分目标和管理方式进行我们自己的排名提升","task_id":"t115870","tasklists":[],"updated_at":"1708481850524","url":"https://applink.feishu.cn/client/todo/detail?guid=2f12eee8-5d5a-4ace-9f83-b8046a7caf82&suite_entity_num=t115870"},{"completed_at":"0","created_at":"1702622507263","creator":{"id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","type":"user"},"dependencies":[],"description":"","extra":"","guid":"c5059f84-ae5f-4e9e-aff8-81029b59208e","is_milestone":false,"members":[{"id":"ou_fc1e75d64fec6e10ce94a