{"type":"message","id":"54ec99f4","parentId":"ac0b5ac5","timestamp":"2026-04-16T22:57:37.524Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在我需要：\n1. 创建一个完整的skill发布工具\n2. 写一个一键发布脚本\n3. 设计多平台发布流程\n\n让我继续创建工具脚本。"},{"type":"toolCall","id":"call_function_7saqmmdi8rkw_1","name":"write","arguments":{"path":"~/workspace/agent/workspace/skills/hotel-skill-generator/scripts/publish.sh","content":"#!/bin/bash\n#===============================================================================\n# 德胧酒店Skill批量发布工具 v1.0\n# \n# 功能：一键将德胧旗下酒店Skill发布到GitHub + ClawHub\n# \n# 使用方法：\n#   ./publish.sh <hotel-name> [platform]\n#   \n#   hotel-name: 酒店英文简称（目录名）\n#   platform:   github | clawhub | all (默认all)\n#\n# 示例：\n#   ./publish.sh delonix-tianjin-riwan\n#   ./publish.sh delonix-tianjin-riwan github\n#\n# 前置要求：\n#   - GitHub CLI (gh) 已安装并登录\n#   - Node.js + npm (用于clawhub CLI)\n#   - clawhub CLI: npm i -g clawhub\n#===============================================================================\n\nset -e\n\n# 颜色定义\nRED='\\033[0;31m'\nGREEN='\\033[0;32m'\nYELLOW='\\033[1;33m'\nBLUE='\\033[0;34m'\nNC='\\033[0m' # No Color\n\n# 配置\nSKILLS_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\nEXAMPLES_DIR=\"${SKILLS_DIR}/examples\"\n\n#-------------------------------------------------------------------------------\n# 辅助函数\n#-------------------------------------------------------------------------------\n\nlog_info() {\n    echo -e \"${BLUE}[INFO]${NC} $1\"\n}\n\nlog_success() {\n    echo -e \"${GREEN}[SUCCESS]${NC} $1\"\n}\n\nlog_warn() {\n    echo -e \"${YELLOW}[WARN]${NC} $1\"\n}\n\nlog_error() {\n    echo -e \"${RED}[ERROR]${NC} $1\"\n}\n\nshow_help() {\n    cat << EOF\n德胧酒店Skill发布工具 v1.0\n\n使用方法：\n  ./publish.sh <hotel-name> [platform]\n\n参数说明：\n  hotel-name  酒店英文简称（必须，对应examples/目录下的子目录名）\n  platform    发布平台：github | clawhub | all（默认all）\n\n示例：\n  ./publish.sh delonix-tianjin-riwan        # 发布到GitHub + ClawHub\n  ./publish.sh delonix-tianjin-riwan github  # 仅发布到GitHub\n\n前置要求：\n  GitHub CLI:  brew install gh && gh auth login\n  ClawHub CLI: npm i -g clawhub && clawhub login\n\nEOF\n}\n\n#-------------------------------------------------------------------------------\n# 平台检查\n#-------------------------------------------------------------------------------\n\ncheck_github_cli() {\n    if ! command -v gh &> /dev/null; then\n        log_error \"GitHub CLI (gh) 未安装\"\n        log_info \"安装方法：brew install gh\"\n        log_info \"登录方法：gh auth login\"\n        return 1\n    fi\n    \n    if ! gh auth status &> /dev/null; then\n        log_error \"GitHub CLI 未登录\"\n        log_info \"请运行：gh auth login\"\n        return 1\n    fi\n    \n    log_success \"GitHub CLI 已就绪\"\n    return 0\n}\n\ncheck_clawhub_cli() {\n    if ! command -v clawhub &> /dev/null; then\n        log_error \"ClawHub CLI 未安装\"\n        log_info \"安装方法：npm i -g clawhub\"\n        return 1\n    fi\n    \n    log_success \"ClawHub CLI 已就绪\"\n    return 0\n}\n\n#-------------------------------------------------------------------------------\n# 发布到GitHub\n#-------------------------------------------------------------------------------\n\npublish_to_github() {\n    local hotel_dir=\"$1\"\n    local repo_name=\"${hotel_dir}-skill\"\n    \n    log_info \"准备发布到GitHub...\"\n    \n    # 检查目录是否存在\n    if [ ! -d \"${EXAMPLES_DIR}/${hotel_dir}\" ]; then\n        log_error \"酒店目录不存在: ${EXAMPLES_DIR}/${hotel_dir}\"\n        return 1\n    fi\n    \n    cd \"${EXAMPLES_DIR}/${hotel_dir}\"\n    \n    # 初始化git（如果需要）\n    if [ ! -d .git ]; then\n        log_info \"初始化Git仓库...\"\n        git init\n        git add .\n        git commit -m \"feat: init $(basename ${hotel_dir}) skill v1.0.0\"\n    fi\n    \n    # 创建GitHub仓库\n    log_info \"创建GitHub仓库: ${repo_name}\"\n    \n    # 检查仓库是否已存在\n    if gh repo view \"${repo_name}\" &> /dev/null; then\n        log_warn \"仓库 ${repo_name} 已存在，跳过创建\"\n    else\n        gh repo create \"${repo_name}\" \\\n            --public \\\n            --description \"德胧集团 $(basename ${hotel_dir}) 酒店专属AI Skill\" \\\n            --homepage \"https://kaiyuanhotels.com\" \\\n            --push\n    fi\n    \n    # 推送代码\n    log_info \"推送代码到GitHub...\"\n    git branch -M main\n    git push -u origin main --force\n    \n    # 创建release\n    log_info \"创建Release v1.0.0...\"\n    gh release create v1.0.0 \\\n        --title \"$(basename ${hotel_dir}) Skill v1.0.0\" \\\n        --notes \"德胧集团 $(basename ${hotel_dir}) 酒店专属AI Skill首发版本\n\n## 功能特性\n- 酒店基础信息查询\n- 会员权益说明\n- 会议宴会服务\n- 交通指南\n\n## 安装方式\n\\`\\`\\`\n帮我安装$(basename ${hotel_dir}) SKILL，技能地址：https://github.com/YOUR_ORG/${repo_name}\n\\`\\`\\`\n\" \\\n        --generate-notes\n    \n    log_success \"GitHub发布完成!\"\n    log_info \"仓库地址: https://github.com/YOUR_ORG/${repo_name}\"\n}\n\n#-------------------------------------------------------------------------------\n# 发布到ClawHub\n#-------------------------------------------------------------------------------\n\npublish_to_clawhub() {\n    local hotel_dir=\"$1\"\n    local skill_slug=\"${hotel_dir}\"\n    \n    log_info \"准备发布到ClawHub...\"\n    \n    # 检查clawhub是否登录\n    if ! clawhub whoami &> /dev/null; then\n        log_error \"ClawHub未登录\"\n        log_info \"请运行：clawhub login\"\n        return 1\n    fi\n    \n    # 检查目录\n    if [ ! -d \"${EXAMPLES_DIR}/${hotel_dir}\" ]; then\n        log_error \"酒店目录不存在: ${EXAMPLES_DIR}/${hotel_dir}\"\n        return 1\n    fi\n    \n    cd \"${EXAMPLES_DIR}/${hotel_dir}\"\n    \n    # 提取版本号（从SKILL.md）\n    local version=$(grep -oP 'version:\\s*\"([^\"]+)\"' SKILL.md 2>/dev/null | cut -d'\"' -f2 || echo \"1.0.0\")\n    \n    # 发布到ClawHub\n    log_info \"发布 ${skill_slug} v${version} 到ClawHub...\"\n    \n    clawhub publish . \\\n        --slug \"${skill_slug}\" \\\n        --name \"$(basename ${hotel_dir})\" \\\n        --version \"${version}\" \\\n        --changelog \"首发版本\"\n    \n    log_success \"ClawHub发布完成!\"\n    log_info \"技能地址: https://clawhub.ai/skills/${skill_slug}\"\n}\n\n#-------------------------------------------------------------------------------\n# 主流程\n#-------------------------------------------------------------------------------\n\nmain() {\n    # 参数检查\n    if [ $# -lt 1 ]; then\n        show_help\n        exit 1\n    fi\n    \n    local hotel_name=\"$1\"\n    local platform=\"${2:-all}\"\n    \n    log_info \"==========================================\"\n    log_info \"德胧酒店Skill发布工具 v1.0\"\n    log_info \"酒店: ${hotel_name}\"\n    log_info \"平台: ${platform}\"\n    log_info \"==========================================\"\n    \n    case \"${platform}\" in\n        github)\n            check_github_cli || exit 1\n            publish_to_github \"${hotel_name}\"\n            ;;\n        clawhub)\n            check_clawhub_cli || exit 1\n            publish_to_clawhub \"${hotel_name}\"\n            ;;\n        all)\n            check_github_cli || exit 1\n            publish_to_github \"${hotel_name}\"\n            echo \"\"\n            check_clawhub_cli || exit 1\n            publish_to_clawhub \"${hotel_name}\"\n            ;;\n        *)\n            log_error \"未知平台: ${platform}\"\n            log_info \"可用平台: github | clawhub | all\"\n            exit 1\n            ;;\n    esac\n    \n    log_success \"==========================================\"\n    log_success \"发布任务完成!\"\n    log_success \"==========================================\"\n}\n\nmain \"$@\"\n"}}],"api":"openai-completions","provider":"minimax-token-plan","model":"MiniMax-M2.7-highspeed","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776380231071,"responseId":"06309c47d547876a01bfd955d1d8e933"}}
