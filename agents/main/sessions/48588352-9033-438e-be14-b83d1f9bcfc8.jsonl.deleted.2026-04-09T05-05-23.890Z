](img_v3_0210i_6589263b-00aa-4834-b2da-e2fd5375fc5g)\n本周APP下载率环比下滑严重的门店@张熙然 @黄承 @晁留柱 @张成 @俞利军 \n![image](img_v3_0210i_6f31a3ff-ad12-48bb-ae2c-65684be682bg)\n本周售卡动销率0的门店@张波 @彭亮 @梁军 @蔡炬炯 @甘亮 @张良强 @李禧 @姚芸 @张成 \n以上门店及总经理，还请重点关注对应营销数据追赶！尤其针对OTA宾客的强感知发展及售卡动作","sender":{"id":"ou_6490bbac2236c018926c92f71cd0bacd","sender_type":"user","name":"张春雷"},"create_time":"2026-04-08T09:28:17+08:00","deleted":false,"updated":true,"mentions":[{"key":"@_user_1","id":"ou_cfad75d1e6e4b69aeb14b89610da8a6a","name":"俞利军"},{"key":"@_user_2","id":"ou_c3f9e56b23bf4a0bfb6a4fdea8ed3e79","name":"吴姜"},{"key":"@_user_3","id":"ou_41c1de197bed6caab041d6deb2ee5456","name":"李昆"},{"key":"@_user_4","id":"ou_76134d6ecd00e7740a8c330d2050078a","name":"邵世骏"},{"key":"@_user_5","id":"ou_b091d3ab1f0ddcdfe7e994bc5eba6293","name":"顾明"},{"key":"@_user_6","id":"ou_7f586325f8b8a6204a6c368384ebc25d","name":"张熙然"},{"key":"@_user_7","id":"ou_be1516db3bb315cb8920a167a43a6c20","name":"黄承"},{"key":"@_user_8","id":"ou_fc1e75d64fec6e10ce94a51adc6f6409","name":"晁留柱"},{"key":"@_user_9","id":"ou_7f42f6aa45620963c5006d6975d8207a","name":"张成"},{"key":"@_user_10","id":"ou_cfad75d1e6e4b69aeb14b89610da8a6a","name":"俞利军"},{"key":"@_user_11","id":"ou_cb514a98aed2478a4909b57ae3c61719","name":"张波"},{"key":"@_user_12","id":"ou_763c8a8536f13c317fc7d719362272c1","name":"彭亮"},{"key":"@_user_13","id":"ou_173fd267bdc92d922bc29a7d0c96ac08","name":"梁军"},{"key":"@_user_14","id":"ou_4925ec7927ab4b8ffee954a50e999c28","name":"蔡炬炯"},{"key":"@_user_15","id":"ou_30c1bce79d6c9b128fd748f64ffbb566","name":"甘亮"},{"key":"@_user_16","id":"ou_5d64a194e6a4d43c9d407532400f52b6","name":"张良强"},{"key":"@_user_17","id":"ou_77250a84d94d3c9ccdbcdf1e2370eff8","name":"李禧"},{"key":"@_user_18","id":"ou_8195e8038b4c59a044a11c38aa990814","name":"姚芸"},{"key":"@_user_19","id":"ou_7f42f6aa45620963c5006d6975d8207a","name":"张成"}]},{"message_id":"om_x100b5279e2c8187cb4cd799858c27a8","msg_type":"text","content":"This message was recalled","sender":{"id":"ou_fc1e75d64fec6e10ce94a