{"type":"message","id":"75d0d20f","parentId":"4b87a64a","timestamp":"2026-04-08T05:03:41.225Z","message":{"role":"toolResult","toolCallId":"call_function_76gqpjp8ggmp_1","toolName":"feishu_im_user_get_messages","content":[{"type":"text","text":"{\n  \"messages\": [\n    {\n      \"message_id\": \"om_x100b527fca9471b8b2ce81a237d9245\",\n      \"msg_type\": \"text\",\n      \"content\": \"<p>https://delonix.feishu.cn/wiki/A4uMw5tt4i4ZEKk2KfZcwk38nGh?from=auth_notice&hash=055d00d17d25eb46ab5bf40f7cd95459</p>\",\n      \"sender\": {\n        \"id\": \"ou_25d7f81a1a402c3e651f0a116ea42f43\",\n        \"sender_type\": \"user\",\n        \"name\": \"闵婷\"\n      },\n      \"create_time\": \"2026-04-07T15:54:45+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b527d57070ca0c3d854a09bb7f49\",\n      \"msg_type\": \"text\",\n      \"content\": \"请问3月的居停天数更新了吗？\",\n      \"sender\": {\n        \"id\": \"ou_9af04341a042e5fc005305351414935f\",\n        \"sender_type\": \"user\",\n        \"name\": \"赵玲云\"\n      },\n      \"create_time\": \"2026-04-07T13:09:48+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b521084bb8538c2480af79a5d486\",\n      \"msg_type\": \"text\",\n      \"content\": \"节后更新ton告知大家\",\n      \"sender\": {\n        \"id\": \"ou_1379fc0ed7eef6d3967df737c9043fba\",\n        \"sender_type\": \"user\",\n        \"name\": \"徐建平\"\n      },\n      \"create_time\": \"2026-04-05T19:51:03+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b52172e1ea130b4c4c2ffae36368\",\n      \"msg_type\": \"text\",\n      \"content\": \"3月居停天数有了吗\",\n      \"sender\": {\n        \"id\": \"ou_752f433b15698c80e72a142163790975\",\n        \"sender_type\": \"user\",\n        \"name\": \"王琼\"\n      },\n      \"create_time\": \"2026-04-05T18:14:37+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b53c0b6d92ca8c44212508d74207\",\n      \"msg_type\": \"text\",\n      \"content\": \"3月居停天数有了吗\",\n      \"sender\": {\n        \"id\": \"ou_752f433b15698c80e72a142163790975\",\n        \"sender_type\": \"user\",\n        \"name\": \"王琼\"\n      },\n      \"create_time\": \"2026-04-03T13:26:25+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b5383ac7040b0c4eb18e84eca349\",\n      \"msg_type\": \"text\",\n      \"content\": \"苏州开元名都招聘房务副总监，负责开元名都、开元名庭两个品牌300间客房的管家方向的运营与管理，意向女士，薪资面议。\\n联系人:周总18368000117\",\n      \"sender\": {\n        \"id\": \"ou_dbfe741b7e1e5626815a74e278aec361\",\n        \"sender_type\": \"user\",\n        \"name\": \"安宝玲\"\n      },\n      \"create_time\": \"2026-03-31T15:56:28+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b54de59bc2ca0c3be69b6ccd242e\",\n      \"msg_type\": \"text\",\n      \"content\": \"家人们有没有推荐好用的木饰面、地板保养剂、价格好效果不错的[双手合十][双手合十][双手合十]给推荐一下\",\n      \"sender\": {\n        \"id\": \"ou_4bcf8aca4a7edb564f88f9f10d2c55a8\",\n        \"sender_type\": \"user\",\n        \"name\": \"洪明珠\"\n      },\n      \"create_time\": \"2026-03-21T21:47:35+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b54fb3f12ec90b2d264837b6be6c\",\n      \"msg_type\": \"system\",\n      \"content\": \"徐建平 将群主转让给 {to_chatter}\",\n      \"sender\": {\n        \"id\": \"\",\n        \"sender_type\": \"\"\n      },\n      \"create_time\": \"2026-03-20T15:28:29+08:00\",\n      \"deleted\": false,\n      \"updated\": false\n    },\n    {\n      \"message_id\": \"om_x100b54fb3e343cb4b36d0363348b1e6\",\n      \"msg_type\": \"system\",\n      \"content\": \"{name} changed settings to: Only group owner and admin can start video calls.\",\n      \"sender\": {\n        \"id\": \"\",\n        \"sender_type\": \"\"\n      },\n      \"create_time\": \"2