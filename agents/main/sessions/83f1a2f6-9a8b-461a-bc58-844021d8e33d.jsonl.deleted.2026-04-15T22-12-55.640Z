e\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_b96327e73fcd6743ef0f7f7e7d06d0d2\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        },\n        {\n          \"id\": \"ou_2ad510ac5c0f020bb3396bbe78bfbcd5\",\n          \"role\": \"follower\",\n          \"type\": \"user\"\n        }\n      ],\n      \"mode\": 2,\n      \"origin\": {\n        \"href\": {\n          \"title\": \"\",\n          \"url\": \"\"\n        },\n        \"platform_i18n_name\": {\n          \"de_de\": \"\",\n          \"en_us\": \"\",\n          \"es_es\": \"\",\n          \"fr_fr\": \"\",\n          \"it_it\": \"\",\n          \"ja_jp\": \"\",\n          \"ko_kr\": \"\",\n          \"ru_ru\": \"\",\n          \"th_th\": \"\",\n          \"zh_cn\": \"\",\n          \"zh_hk\": \"\",\n          \"zh_tw\": \"\"\n        }\n      },\n      \"parent_task_guid\": \"\",\n      \"repeat_rule\": \"\",\n      \"source\": 2,\n      \"status\": \"todo\",\n      \"subtask_count\": 0,\n      \"summary\": \"@刘东东  把PMS培训文档导出,上传豆包,把会员营销最新版知识导出上传豆包,这样就生成一份培训底档,然后要求豆包根据内容生成培训滚动进程@郑伟  这个其实很简单,也有意思,要擅用AI,同时,还要把关键内容特别和豆包交待清楚,还是需要多次和豆包聊天才能找到更接近的成果. 包括我们的保养工作到底怎么形成规律性的滚动,也是必要通过豆包来帮忙进行排序、但要和豆包告诉清楚我们每天的人力配置、我们的区域面积和单位作业时长.@李文娇 \",\n      \"task_id\": \"t133892\",\n      \"tasklists\": [],\n      \"updated_at\": \"1765235930441\",\n      \"url\": \"https://applink.feishu.cn/client/todo/detail?guid=381a196d-a437-4c56-9afc-daba109971b5&suite_entity_num=t133892\"\n    },\n    {\n      \"completed_at\": \"1765445063905\",\n      \"created_at\": \"1764469270849\",\n      \"creator\": {\n        \"id\": \"ou_fc1e75d64fec6e10ce94a51adc6f6409\",\n        \"type\": \"user\"\n      },\n      \"dependencies\": [],\n      \"description\": \"基于效果评估结果优化唤醒策略，建立客户分层维护机制及预防沉睡预警体系\",\n      \"due\": {\n        \"is_all_day\": false,\n        \"timestamp\": \"1764485999000\"\n      },\n      \"extra\": \"\",\n      \"guid\": \"b824fe6d-8ecf-49af-b2